# Clave de API de Plant.id (NO exponer en el cliente)
PLANT_ID_API_KEY=your-plant-id-api-key-here

# Email opcional para aumentar cuota de MyMemory (10.000 palabras/día con email vs 500 sin él)
MYMEMORY_EMAIL=breinermunoz05@gmail.com

# Puerto del servidor (Render lo inyecta automáticamente)
PORT=3000

# JWT secret (debe ser el MISMO en local y en Render si quieres que los tokens funcionen entre ambos)
JWT_SECRET=change-me
